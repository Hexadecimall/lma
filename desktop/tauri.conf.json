{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lma",
  "version": "0.3.2",
  "identifier": "org.lma.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "lma",
        "create": false,
        "width": 1180,
        "height": 820,
        "minWidth": 640,
        "minHeight": 480,
        "theme": "Dark",
        "backgroundColor": "#101216"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Local models, chat, and code",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "12.0", "infoPlist": "Info.plist" }
  }
}
